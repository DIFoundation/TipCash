# Authentication
JWT_SECRET=your-jwt-secret-key-here-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-here-change-in-production

# Database Configuration
NEXT_PUBLIC_SUPABASE_URL=your-database-url-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

DATABASE_PROJECT_NAME=your-database-project-name-here
DATABASE_project_PASSWORD=your-database-project-password-here

# Provider: zallet | tatum
ZCASH_PROVIDER=zallet

# Zallet Configuration
ZCASH_RPC_URL=http://127.0.0.1:28232
ZCASH_RPC_USER=tipcash
ZCASH_RPC_PASSWORD=your_password

# Tatum fallback
TATUM_RPC_URL=https://zcash-mainnet.gateway.tatum.io
TATUM_API_KEY=YOUR_API_KEY

# Optional: Email Service (for notifications)
# SENDGRID_API_KEY=your-sendgrid-key-here
# SENDGRID_FROM_EMAIL=noreply@tipcash.com


